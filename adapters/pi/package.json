{
  "name": "autojournal",
  "version": "1.0.4",
  "description": "Durable agent memory for the Pi coding agent: every completed turn becomes an owner-controlled Markdown episode, with exact, ranked, bounded recall.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "agent-memory",
    "extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Middlewatch/autojournal.git"
  },
  "engines": {
    "node": ">=22.6"
  },
  "files": [
    "index.ts",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "scripts/check-package.mjs"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "prepack": "node scripts/check-package.mjs",
    "prepublishOnly": "../../scripts/release-check.sh"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80 <1.0",
    "@types/node": "^26.0.0",
    "typebox": "^1.0.55",
    "typescript": "^5.0.0"
  }
}
